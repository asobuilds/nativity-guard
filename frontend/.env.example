# Frontend environment variables
# Copy this file to .env.local and fill in your values

# API base URL (backend)
VITE_API_URL=https://nativityguard-backend.onrender.com

# Media base URL for avatars/covers (e.g. Supabase storage public URL)
# The backend returns relative paths like "avatars/2026/09/hash.jpg"
# This prefix makes them renderable from the frontend origin
VITE_MEDIA_BASE=https://<project>.supabase.co/storage/v1/object/public/nativityguard-media

# Set to "true" to use mock API responses during development
VITE_USE_MOCKS=false