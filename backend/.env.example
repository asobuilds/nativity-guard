# Media storage (Supabase Storage)
# When MEDIA_ENDPOINT is set the backend uploads to Supabase; when it is absent the
# backend falls back to the legacy local disk under STORAGE_ROOT.
# The Supabase project URL goes in MEDIA_ENDPOINT as
# https://<project>.supabase.co/storage/v1/s3
# The public base goes in MEDIA_PUBLIC_BASE as
# https://<project>.supabase.co/storage/v1/object/public/nativityguard-media
MEDIA_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
MEDIA_REGION=eu-west-2
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_BUCKET=nativityguard-media
MEDIA_PUBLIC_BASE=https://<project>.supabase.co/storage/v1/object/public/nativityguard-media

# Legacy local-disk fallback
STORAGE_ROOT=./storage

# The Guardian Open Platform news API — https://open-platform.theguardian.com/
# Free tier. Sign up to get a key, then paste it here for local dev.
# In production, set this on the Render backend service.
GUARDIAN_API_KEY=
