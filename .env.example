# ==========================================
# NATIVITY GUARD — ENVIRONMENT CONFIGURATION
# ==========================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nativity_guard?sslmode=disable

# Security & Server
JWT_SECRET=super-secret-jwt-key-change-in-production
PORT=8080
GIN_MODE=release
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Media Storage (Supabase S3 / Local Disk Fallback)
MEDIA_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
MEDIA_REGION=eu-west-2
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
MEDIA_BUCKET=nativityguard-media
MEDIA_PUBLIC_BASE=https://<project>.supabase.co/storage/v1/object/public/nativityguard-media
STORAGE_ROOT=./storage

# Redis Caching
REDIS_URL=redis://localhost:6379

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=mailto:support@nativityguard.org

# External APIs
GUARDIAN_API_KEY=
